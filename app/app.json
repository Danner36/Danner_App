{
  "expo": {
    "name": "Danner Apps",
    "slug": "danner-app",
    "scheme": "dannerapp",
    "version": "1.0",
    "orientation": "default",
    "icon": "./assets/ic_launcher_danner.jpg",
    "backgroundColor": "#F7F7F2",
    "primaryColor": "#1F6F55",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danner.locationhelper",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsForMedia": true,
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Danner Apps connects to home video streams on your local network.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.example.location_helper",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.INTERNET",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#00000000",
          "style": "dark",
          "position": "absolute"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F2",
          "image": "./assets/ic_launcher_danner.jpg",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "react-native-google-cast",
        {
          "expandedController": false,
          "receiverAppId": "CC1AD845"
        }
      ],
      "./plugins/withGoogleCastNative"
    ]
  }
}
