{
  "name": "danner-app",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:offline-map": "node scripts/build-offline-map.mjs",
    "test:leagues": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tests/leagues/run.mjs",
    "test:team-engine": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tests/team-engine/run.mjs",
    "test:imports": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tests/imports/run.mjs",
    "test:team:android": "node ../tests/team-harness/run-android.mjs",
    "test:team:android:all": "node ../tests/team-harness/run-android.mjs --all",
    "test:team:android:get-video": "node ../tests/team-harness/run-get-video.mjs",
    "test:team:server": "node ../tests/team-harness/server.mjs",
    "test:playback:cast-discovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tests/playback/run-cast-discovery.mjs",
    "test:playback:android:cast-web": "node ../tests/playback/run-cast-web.mjs",
    "test:playback:android:shell-fix": "node ../tests/playback/run-shell-fix.mjs",
    "test:offline-map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tests/offline-map/run.mjs",
    "test:provisioning-warning": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tests/provisioning-warning/run.mjs",
    "test:app-update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tests/app-update/run.mjs",
    "test:scoreboards": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tests/scoreboards/run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-build-properties": "~57.0.15",
    "expo-keep-awake": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-cast": "^4.9.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
